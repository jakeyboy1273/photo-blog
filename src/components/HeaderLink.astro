---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

function normalize(path: string): string {
  const trimmed = path.replace(/\/+$/, "");
  return trimmed === "" ? "/" : trimmed;
}

const current = normalize(Astro.url.pathname);
const target = normalize(String(href ?? ""));
const base = normalize(import.meta.env.BASE_URL);
const isActive =
  current === target || (target !== base && current.startsWith(`${target}/`));
---

<a
  href={href}
  class:list={[
    "px-2 py-1 text-sm text-muted no-underline transition-colors hover:text-ink",
    { "font-semibold text-ink": isActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>
