---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLTag } from "astro/types";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  image: ImageMetadata | Promise<{ default: ImageMetadata }>;
  title: string;
  description?: string;
  date?: Date;
  kind?: "Story" | "Gallery";
  alt?: string;
  href?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  isFirst?: boolean;
}

const {
  image,
  title,
  description,
  date,
  kind,
  alt = title,
  href,
  isFirst = false,
  loading = isFirst ? "eager" : "lazy",
  fetchpriority = isFirst ? "high" : "auto",
} = Astro.props;

const Tag = (href ? "a" : "div") as HTMLTag;
const cardClass =
  "group flex h-full flex-col text-inherit no-underline transition-opacity duration-300 hover:opacity-90";
---

<Tag href={href} class={cardClass}>
  <div class="aspect-[16/10] w-full overflow-hidden rounded-xl">
    <Image
      src={image}
      alt={alt}
      widths={[400, 600, 900]}
      sizes="(max-width: 639px) 100vw, 50vw"
      quality={75}
      format="webp"
      loading={loading}
      fetchpriority={fetchpriority}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-col items-center px-1 pt-3 text-center sm:pt-4">
    {
      (date || kind) && (
        <p class="m-0 text-xs tracking-wide text-muted">
          {date && <FormattedDate date={date} />}
          {date && kind && <span aria-hidden="true"> · </span>}
          {kind}
        </p>
      )
    }
    <p
      class:list={[
        "m-0 text-sm font-bold text-ink sm:text-base",
        date || kind ? "mt-1.5" : "",
      ]}
    >
      {title}
    </p>
    {
      description && (
        <p class="m-0 mt-1 line-clamp-2 text-xs leading-snug text-muted sm:text-sm">
          {description}
        </p>
      )
    }
  </div>
</Tag>
