---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLTag } from "astro/types";

interface Props {
  image: ImageMetadata | Promise<{ default: ImageMetadata }>;
  title: string;
  description?: string;
  alt?: string;
  href?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  isFirst?: boolean;
}

const {
  image,
  title,
  description,
  alt = title,
  href,
  isFirst = false,
  loading = isFirst ? "eager" : "lazy",
  fetchpriority = isFirst ? "high" : "auto",
} = Astro.props;

const Tag = (href ? "a" : "div") as HTMLTag;
const cardClass =
  "flex h-full flex-col overflow-hidden rounded-lg bg-surface text-inherit no-underline shadow-lg transition-transform duration-300 hover:scale-105";
---

<Tag href={href} class={cardClass}>
  <div class="aspect-[5/4] w-full overflow-hidden">
    <Image
      src={image}
      alt={alt}
      widths={[400, 600, 800]}
      sizes="(max-width: 1023px) 50vw, 33vw"
      quality={75}
      format="webp"
      loading={loading}
      fetchpriority={fetchpriority}
      class="h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-col items-center justify-center px-2 py-2 text-center sm:px-3 sm:py-3">
    <p class="m-0 text-xs font-medium text-ink sm:text-sm md:text-base">
      {title}
    </p>
    {
      description && (
        <p class="m-0 mt-0.5 line-clamp-2 text-xs leading-snug text-muted">
          {description}
        </p>
      )
    }
  </div>
</Tag>
