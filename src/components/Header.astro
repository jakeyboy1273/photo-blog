---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import GitHubLink from "./GitHubLink.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="border-b border-line bg-surface">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
  >
    <p class="m-0 text-lg font-bold tracking-tight">
      <a href={`${base}/`} class="text-ink no-underline hover:text-ink"
        >{SITE_TITLE}</a
      >
    </p>
    <div class="flex items-center gap-1 sm:gap-2">
      <HeaderLink href={`${base}/stories/`}>Stories</HeaderLink>
      <HeaderLink href={`${base}/galleries/`}>Galleries</HeaderLink>
      <div class="ml-1 hidden sm:block">
        <GitHubLink />
      </div>
    </div>
  </nav>
</header>
