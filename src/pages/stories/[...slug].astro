---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Story from '../../layouts/Story.astro';
import Lightbox from '../../components/Lightbox.astro';
import Figure from '../../components/Figure.astro';
import { getCleanSlug } from '../../utils/slug';

export async function getStaticPaths() {
    const posts = await getCollection('stories');
    return posts.map((post: CollectionEntry<'story'>) => {
        const slug = getCleanSlug(post.id);
        
        return {
            params: { slug: slug }, 
            props: post,
        };
    });
}
type Props = CollectionEntry<'story'>;

const post = Astro.props;
const { Content } = await render(post);
---

<Story {...post.data}>
	<Content components={{ Figure }} />
	<Lightbox />
</Story>
