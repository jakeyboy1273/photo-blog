---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Story from "../../layouts/Story.astro";
import Lightbox from "../../components/Lightbox.astro";
import Figure from "../../components/Figure.astro";
import { getCleanSlug } from "../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("stories");
  return posts.map((post: CollectionEntry<"stories">) => {
    const cleanId = getCleanSlug(post.id);

    return {
      params: { id: cleanId },
      props: post,
    };
  });
}

type Props = CollectionEntry<"stories">;

const post = Astro.props;
const { Content } = await render(post);
---

<Story {...post.data} id={post.id}>
  <Content components={{ Figure }} />
  <Lightbox />
</Story>
