---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getCleanSlug } from "../../utils/slug";

const base = import.meta.env.BASE_URL;
type Story = CollectionEntry<"stories">;

const posts = (await getCollection("stories")).sort(
  (a: Story, b: Story) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={`Stories | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="p-8">
    <h1 class="text-5xl font-bold text-center my-8">Stories</h1>
    <div class="mx-auto container max-w-(--breakpoint-sm) grid grid-cols-2 gap-8">
      {
        posts.map((post: Story, index: number) => {
          const cleanSlug = getCleanSlug(post.id);

          return (
            <Card
              href={`${base}/stories/${cleanSlug}/`}
              image={post.data.heroImage}
              title={post.data.title}
              description={post.data.description}
              isFirst={index === 0}
            />
          );
        })
      }
    </div>
  </div>
</BaseLayout>
