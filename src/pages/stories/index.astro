---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getCleanSlug } from "../../utils/slug";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
type Story = CollectionEntry<"stories">;

const posts = (await getCollection("stories")).sort(
  (a: Story, b: Story) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Stories | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="mb-10 text-center text-4xl font-bold">Stories</h1>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10">
      {
        posts.map((post: Story, index: number) => {
          if (!post.data.heroImage) return null;

          const cleanId = getCleanSlug(post.id);

          return (
            <Card
              href={`${base}/stories/${cleanId}/`}
              image={post.data.heroImage}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              kind="Story"
              isFirst={index === 0}
            />
          );
        })
      }
    </div>
  </main>
</BaseLayout>
