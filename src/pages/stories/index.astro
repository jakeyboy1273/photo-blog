---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const base = import.meta.env.BASE_URL;
type Story = CollectionEntry<"stories">;

const posts = (await getCollection("stories")).sort(
  (a: Story, b: Story) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="p-8">
      <h1 class="text-5xl font-bold text-center my-8">Stories</h1>
      <div class="mx-auto container max-w-(--breakpoint-sm) grid grid-cols-2 gap-8">
        {
          posts.map((post: Story) => {
            const cleanSlug = post.id.replace(/\/index$/, "").replace(/\.(md|mdx)$/, "");

            return (
              <a href={`${base}/stories/${cleanSlug}/`} class="group transition-all mb-4 block">
                {post.data.heroImage && (
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.title}
                    layout="constrained"
                    quality={70}
                    widths={[400, 750, 1080]}
                    sizes="(max-width: 640px) 100vw, 50vw"
                    loading={posts.indexOf(post) === 0 ? "eager" : "lazy"}
                    fetchpriority={posts.indexOf(post) === 0 ? "high" : "auto"}
                    class:list={["rounded-lg transition-all", "group-hover:shadow-lg group-hover:opacity-90"]}
                  />
                )}
                <div class="mt-4 text-center text-neutral-700">
                  <strong class="font-normal">{post.data.title}</strong>
                  {post.data.description && <p class="text-xs">{post.data.description}</p>}
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </BaseLayout>
</html>
