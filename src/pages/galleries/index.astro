---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getCleanSlug } from "../../utils/slug";

const base = import.meta.env.BASE_URL;
const galleries: CollectionEntry<"galleries">[] = await getCollection("galleries");
---

<BaseLayout title={`Galleries | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="p-8">
    <h1 class="text-5xl font-bold text-center my-8">Gallery</h1>
    <div class="mx-auto container max-w-(--breakpoint-sm) grid grid-cols-2 gap-8">
      {
        galleries.map((item, index) => {
          const cleanId = getCleanSlug(item.id);

          return (
            <Card
              href={`${base}/galleries/${cleanId}`}
              image={item.data.cover}
              title={item.data.title}
              description={item.data.description}
              isFirst={index === 0}
            />
          );
        })
      }
    </div>
  </div>
</BaseLayout>