---
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Gallery from "../../layouts/Gallery.astro";
import type { GalleryPhoto } from "../../components/GalleryAlbum";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");

  return galleries.map((gallery: CollectionEntry<"galleries">) => {
    return {
      params: { id: gallery.id },
      props: { gallery },
    };
  });
}

interface Props {
  gallery: CollectionEntry<"galleries">;
}

const THUMB_WIDTHS = [400, 800, 1200] as const;

async function toGalleryPhoto(
  img: { file: ImageMetadata; caption?: string },
  galleryTitle: string,
): Promise<GalleryPhoto> {
  const srcSet = await Promise.all(
    THUMB_WIDTHS.map(async (width) => {
      const optimized = await getImage({
        src: img.file,
        width,
        format: "webp",
        quality: 70,
      });
      return {
        src: optimized.src,
        width: Number(optimized.attributes.width),
        height: Number(optimized.attributes.height),
      };
    }),
  );

  const full = await getImage({
    src: img.file,
    width: Math.min(img.file.width, 2560),
    format: "webp",
    quality: 80,
  });

  const largest = srcSet[srcSet.length - 1];

  return {
    src: largest.src,
    width: img.file.width,
    height: img.file.height,
    alt: img.caption || `Image from ${galleryTitle}`,
    href: full.src,
    srcSet,
    caption: img.caption,
  };
}

const { gallery } = Astro.props as Props;
const photos = await Promise.all(
  gallery.data.images.map((img: { file: ImageMetadata; caption?: string }) =>
    toGalleryPhoto(img, gallery.data.title),
  ),
);
---

<Gallery {...gallery.data} id={gallery.id} photos={photos} />
