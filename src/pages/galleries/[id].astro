---
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import GalleryAlbum, {
  type GalleryPhoto,
} from "../../components/GalleryAlbum";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Lightbox from "../../components/Lightbox.astro";
import { getCleanSlug } from "../../utils/slug";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");

  return galleries.map((gallery: CollectionEntry<"galleries">) => {
    const cleanId = getCleanSlug(gallery.id);

    return {
      params: { id: cleanId },
      props: { gallery },
    };
  });
}

interface Props {
  gallery: CollectionEntry<"galleries">;
}

const THUMB_WIDTHS = [400, 800, 1200] as const;

async function toGalleryPhoto(
  img: { file: ImageMetadata; caption?: string },
  galleryTitle: string,
): Promise<GalleryPhoto> {
  const srcSet = await Promise.all(
    THUMB_WIDTHS.map(async (width) => {
      const optimized = await getImage({
        src: img.file,
        width,
        format: "webp",
        quality: 70,
      });
      return {
        src: optimized.src,
        width: Number(optimized.attributes.width),
        height: Number(optimized.attributes.height),
      };
    }),
  );

  const full = await getImage({
    src: img.file,
    width: Math.min(img.file.width, 2560),
    format: "webp",
    quality: 80,
  });

  const largest = srcSet[srcSet.length - 1];

  return {
    src: largest.src,
    width: img.file.width,
    height: img.file.height,
    alt: img.caption || `Image from ${galleryTitle}`,
    href: full.src,
    srcSet,
    caption: img.caption,
  };
}

const { gallery } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const photos = await Promise.all(
  gallery.data.images.map((img: { file: ImageMetadata; caption?: string }) =>
    toGalleryPhoto(img, gallery.data.title),
  ),
);
---

<BaseLayout
  title={`${gallery.data.title} | ${SITE_TITLE}`}
  description={gallery.data.description || SITE_DESCRIPTION}
>
  <main class="px-4 py-12">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold sm:text-4xl lg:text-5xl">
        {gallery.data.title}
      </h1>
      {
        gallery.data.description && (
          <p class="mt-4 text-base text-muted sm:text-lg">
            {gallery.data.description}
          </p>
        )
      }
      {
        gallery.data.date && (
          <p class="mt-3 text-sm text-muted">
            <FormattedDate date={gallery.data.date} />
          </p>
        )
      }
    </div>

    <div class="mt-10">
      <GalleryAlbum photos={photos} />
    </div>

    <p class="mt-10 text-center text-base">
      <a
        href={`${base}/galleries/`}
        class="text-muted no-underline hover:text-ink hover:underline"
        >← Go back</a
      >
    </p>
  </main>
  <Lightbox />
</BaseLayout>
