---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");

  return galleries.map((gallery: CollectionEntry<"galleries">) => {
    const cleanId = gallery.id.replace(/\/index$/, "").replace(/\.(yaml|yml|json)$/, "");
    
    return {
      params: { id: cleanId },
      props: { gallery },
    };
  });
}

interface Props {
  gallery: CollectionEntry<"galleries">;
}

const { gallery } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const images = gallery.data.images;
---

<!doctype html>
<html lang="en">
  <BaseLayout title={`${gallery.data.title} | ${SITE_TITLE}`} description={gallery.data.description || SITE_DESCRIPTION}>
    <div class="text-center my-16 mb-32">
      <h1 class="text-3xl xl:text-6xl font-bold">
        {gallery.data.title}
      </h1>
      {gallery.data.description && (
        <p class="text-lg xl:text-2xl mt-4 mb-2">
          {gallery.data.description}
        </p>
      )}
      {gallery.data.date && (
        <p class="text-sm md:text-base text-gray-400 mb-8">
          <FormattedDate date={gallery.data.date} />
        </p>
      )}
    
      <div class="flex justify-center my-8">
        <div id="gallery" class="max-w-[95vw] px-4 w-full columns-1 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5 gap-4 space-y-4">
          {images.map((img: { file: ImageMetadata; caption?: string }, index: number) => {
            return (
              <a 
                href={img.file.src} 
                data-pswp-width={img.file.width} 
                data-pswp-height={img.file.height} 
                data-pswp-caption={img.caption || ""}
                target="_blank"
                class="group relative block overflow-hidden rounded-md border border-transparent hover:border-gray-300 transition-all duration-300 ease-in-out hover:shadow-lg w-full break-inside-avoid"
              >
                <Image
                  src={img.file}
                  alt={img.caption || `Image from ${gallery.data.title} gallery`}
                  layout="constrained"
                  quality={70}
                  widths={[400, 750, 1080]}
                  sizes="(max-width: 640px) 100vw,
                          (max-width: 768px) 50vw,
                          (max-width: 1024px) 33vw,
                          25vw"
                  class="w-full h-auto object-cover rounded-md group-hover:scale-105 transition-transform duration-500 ease-out block"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              </a>
            );
          })}
        </div>
      </div>
    
      <p class="text-lg my-4 text-center">
        <a href={`${base}/galleries/`} class="text-gray-400 hover:text-white hover:underline transition-colors"
          >← Go back</a
        >
      </p>
    </div>
    <Lightbox />
  </BaseLayout>
</html>