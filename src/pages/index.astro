---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import PageIntro from "../components/PageIntro.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

type Story = CollectionEntry<"stories">;
type Gallery = CollectionEntry<"galleries">;

type FeedItem = {
  href: string;
  image: NonNullable<Story["data"]["heroImage"]> | Gallery["data"]["cover"];
  title: string;
  description: string;
  tripDate: Date;
  pubDate: Date;
  kind: "Story" | "Gallery";
};

const stories = await getCollection("stories");
const galleries = await getCollection("galleries");

const storyItems: FeedItem[] = stories
  .filter((post: Story) => post.data.heroImage)
  .map((post: Story) => ({
    href: `${base}/stories/${post.id}/`,
    image: post.data.heroImage!,
    title: post.data.title,
    tripDate: post.data.tripDate,
    pubDate: post.data.pubDate,
    kind: "Story",
  }));

const galleryItems: FeedItem[] = galleries.map((item: Gallery) => ({
  href: `${base}/galleries/${item.id}/`,
  image: item.data.cover,
  title: item.data.title,
  tripDate: item.data.tripDate,
  pubDate: item.data.pubDate,
  kind: "Gallery",
}));

const items = [...storyItems, ...galleryItems].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <PageIntro
      title="🚀 Jake's Jolly Jaunts 🌍"
      description="Welcome to my collection of photos and stories from all my adventures around the world!
      I built this website myself to have a nice place to share my pictures and tell my tales."
    />
    <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8">
      {
        items.map((item, index) => (
          <Card
            href={item.href}
            image={item.image}
            title={item.title}
            description={item.description}
            date={item.tripDate}
            kind={item.kind}
            isFirst={index === 0}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
