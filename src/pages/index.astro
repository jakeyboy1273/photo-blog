---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCleanSlug } from "../utils/slug";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

type Story = CollectionEntry<"stories">;
type Gallery = CollectionEntry<"galleries">;

type FeedItem = {
  href: string;
  image: NonNullable<Story["data"]["heroImage"]> | Gallery["data"]["cover"];
  title: string;
  description: string;
  date: Date;
  kind: "Story" | "Gallery";
};

const stories = await getCollection("stories");
const galleries = await getCollection("galleries");

const storyItems: FeedItem[] = stories
  .filter((post: Story) => post.data.heroImage)
  .map((post: Story) => ({
    href: `${base}/stories/${getCleanSlug(post.id)}/`,
    image: post.data.heroImage!,
    title: post.data.title,
    description: post.data.description,
    date: post.data.pubDate,
    kind: "Story",
  }));

const galleryItems: FeedItem[] = galleries
  .filter((item: Gallery) => item.data.date)
  .map((item: Gallery) => ({
    href: `${base}/galleries/${getCleanSlug(item.id)}/`,
    image: item.data.cover,
    title: item.data.title,
    description: item.data.description,
    date: item.data.date!,
    kind: "Gallery",
  }));

const items = [...storyItems, ...galleryItems].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-bold">My Photography Blog!</h1>
    <p>
      This website is a work in progress. So far I am hoping to add some of my
      favourite photos and stories from my travels.
    </p>
    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10">
      {
        items.map((item, index) => (
          <Card
            href={item.href}
            image={item.image}
            title={item.title}
            description={item.description}
            date={item.date}
            kind={item.kind}
            isFirst={index === 0}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
