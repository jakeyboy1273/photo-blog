---
import { getEntry, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import GalleryAlbum, {
  type GalleryPhoto,
} from "../components/GalleryAlbum";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Lightbox from "../components/Lightbox.astro";
import BackLink from "../components/BackLink.astro";
import TripCrossLink from "../components/TripCrossLink.astro";

type Props = CollectionEntry<"galleries">["data"] & {
  id: string;
  photos: GalleryPhoto[];
};

const { id, title, description, tripDate, photos } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Link to a story with the same content id, if one exists.
const relatedStory = await getEntry("stories", id);
const relatedStoryHref = relatedStory
  ? `${base}/stories/${relatedStory.id}/`
  : undefined;
---

<BaseLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description || SITE_DESCRIPTION}
>
  <main class="px-4 py-12">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold sm:text-4xl lg:text-5xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-4 text-base text-muted sm:text-lg">
            {description}
          </p>
        )
      }
      <p class="mt-3 text-sm text-muted">
        <FormattedDate date={tripDate} />
      </p>
      {
        relatedStoryHref && (
          <TripCrossLink href={relatedStoryHref} label="Read the story →" />
        )
      }
    </div>

    <div class="mt-10">
      <GalleryAlbum photos={photos} />
    </div>

    <BackLink href={`${base}/galleries/`} />
  </main>
  <Lightbox />
</BaseLayout>
