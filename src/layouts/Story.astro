---
import { Image, getImage } from "astro:assets";
import { getEntry, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import BackLink from "../components/BackLink.astro";
import TripCrossLink from "../components/TripCrossLink.astro";
import { getCleanSlug } from "../utils/slug";

type Props = CollectionEntry<"stories">["data"] & { id: string };
const {
  id,
  title,
  description,
  tripDate,
  updatedDate,
  heroImage,
  heroCaption,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Link to a gallery with the same content id, if one exists.
const relatedGallery = await getEntry("galleries", id);
const relatedGalleryHref = relatedGallery
  ? `${base}/galleries/${getCleanSlug(relatedGallery.id)}/`
  : undefined;

const heroLightbox = heroImage
  ? await getImage({
      src: heroImage,
      width: Math.min(heroImage.width, 2560),
      format: "webp",
      quality: 80,
    })
  : null;
---

<BaseLayout title={title} description={description}>
  <main class="px-4 py-12">
    <article>
      <header class="mx-auto max-w-3xl text-center">
        <h1 class="text-3xl font-bold sm:text-4xl lg:text-5xl">{title}</h1>
        {
          description && (
            <p class="mt-4 text-base text-muted sm:text-lg">{description}</p>
          )
        }
        <p class="mt-3 text-sm text-muted">
          <FormattedDate date={tripDate} />
        </p>
        {
          updatedDate && (
            <p class="mt-1 text-sm italic text-muted">
              Last updated on <FormattedDate date={updatedDate} />
            </p>
          )
        }
        {
          relatedGalleryHref && (
            <TripCrossLink
              href={relatedGalleryHref}
              label="View the photo gallery →"
            />
          )
        }
      </header>

      {
        heroImage && heroLightbox && (
          <div class="hero-image mx-auto w-full max-w-4xl">
            <div class="aspect-[2/1] overflow-hidden rounded-xl sm:aspect-[21/9]">
              <a
                href={heroLightbox.src}
                data-pswp-width={heroImage.width}
                data-pswp-height={heroImage.height}
                data-pswp-caption={heroCaption ?? ""}
                target="_blank"
                rel="noreferrer"
                class="block h-full w-full"
                aria-label={
                  heroCaption
                    ? `View full-size: ${heroCaption}`
                    : `View full-size image for ${title}`
                }
              >
                <Image
                  src={heroImage}
                  alt=""
                  widths={[720, 1280, 1920]}
                  quality={75}
                  sizes="(max-width: 896px) calc(100vw - 2rem), 896px"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover object-center"
                />
              </a>
            </div>
          </div>
        )
      }

      <div class="prose mx-auto w-full max-w-4xl py-8 text-ink">
        <slot />
      </div>
    </article>

    <div class="mx-auto w-full max-w-4xl">
      <BackLink href={`${base}/stories/`} />
    </div>
  </main>
</BaseLayout>
