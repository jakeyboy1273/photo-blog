---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"stories">["data"];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main>
    <article>
      <div class="hero-image mx-auto w-full max-w-6xl px-4 pt-6">
        {
          heroImage && (
            <Image
              src={heroImage}
              alt=""
              widths={[720, 1280, 1920, 2560]}
              quality={75}
              sizes="(max-width: 1152px) calc(100vw - 2rem), 1152px"
              loading="eager"
              fetchpriority="high"
              class="mx-auto block h-auto w-full rounded-xl"
            />
          )
        }
      </div>
      <div class="prose mx-auto w-full max-w-4xl px-4 py-8 text-ink">
        <div class="mb-8 py-4 text-center leading-none">
          <div class="mb-2 text-muted">
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <div class="italic">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1 class="mb-4 text-3xl sm:text-4xl">{title}</h1>
          <hr />
        </div>
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
