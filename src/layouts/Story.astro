---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import BackLink from "../components/BackLink.astro";

type Props = CollectionEntry<"stories">["data"];
const { title, description, tripDate, updatedDate, heroImage, heroCaption } =
  Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroLightbox = heroImage
  ? await getImage({
      src: heroImage,
      width: Math.min(heroImage.width, 2560),
      format: "webp",
      quality: 80,
    })
  : null;
---

<BaseLayout title={title} description={description}>
  <main>
    <article>
      <header class="mx-auto w-full max-w-4xl px-4 pt-10 pb-6 text-center">
        <div class="mb-3 text-sm text-muted">
          <FormattedDate date={tripDate} />
          {
            updatedDate && (
              <div class="mt-1 italic">
                Last updated on <FormattedDate date={updatedDate} />
              </div>
            )
          }
        </div>
        <h1 class="mb-0 text-3xl tracking-tight sm:text-4xl">{title}</h1>
      </header>

      {
        heroImage && heroLightbox && (
          <div class="hero-image mx-auto w-full max-w-4xl px-4">
            <div class="aspect-[2/1] overflow-hidden rounded-xl sm:aspect-[21/9]">
              <a
                href={heroLightbox.src}
                data-pswp-width={heroImage.width}
                data-pswp-height={heroImage.height}
                data-pswp-caption={heroCaption ?? ""}
                target="_blank"
                rel="noreferrer"
                class="block h-full w-full"
                aria-label={
                  heroCaption
                    ? `View full-size: ${heroCaption}`
                    : `View full-size image for ${title}`
                }
              >
                <Image
                  src={heroImage}
                  alt=""
                  widths={[720, 1280, 1920]}
                  quality={75}
                  sizes="(max-width: 896px) calc(100vw - 2rem), 896px"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover object-center"
                />
              </a>
            </div>
          </div>
        )
      }

      <div class="prose mx-auto w-full max-w-4xl px-4 py-8 text-ink">
        <slot />
      </div>
    </article>

    <div class="mx-auto w-full max-w-4xl px-4 pb-8">
      <BackLink href={`${base}/stories/`} />
    </div>
  </main>
</BaseLayout>
