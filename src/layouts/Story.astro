---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"stories">["data"];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main>
    <article>
      <header class="mx-auto w-full max-w-4xl px-4 pt-10 pb-6 text-center">
        <div class="mb-3 text-sm text-muted">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <div class="mt-1 italic">
                Last updated on <FormattedDate date={updatedDate} />
              </div>
            )
          }
        </div>
        <h1 class="mb-0 text-3xl tracking-tight sm:text-4xl">{title}</h1>
      </header>

      {
        heroImage && (
          <div class="mx-auto w-full max-w-4xl px-4">
            <div class="aspect-[2/1] overflow-hidden rounded-xl sm:aspect-[21/9]">
              <Image
                src={heroImage}
                alt=""
                widths={[720, 1280, 1920]}
                quality={75}
                sizes="(max-width: 896px) calc(100vw - 2rem), 896px"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover object-center"
              />
            </div>
          </div>
        )
      }

      <div class="prose mx-auto w-full max-w-4xl px-4 py-8 text-ink">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
